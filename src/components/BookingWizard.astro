---
import { money } from '../lib/money';
import { formatDuration } from '../lib/duration';

interface Props {
  services: {
    id: number; name: string; slug: string; description: string; hasSizes: boolean;
    priceFlat: number | null; priceS: number | null; priceM: number | null;
    priceL: number | null; priceXl: number | null;
    durationFlat: number | null; durationS: number | null; durationM: number | null;
    durationL: number | null; durationXl: number | null;
  }[];
  addons: { id: number; name: string; priceCents: number }[];
  preselect: string | null;
  sizeLabels: Record<string, string>;
}
const { services, addons, preselect, sizeLabels } = Astro.props;
const sizes = ['small', 'medium', 'large', 'xl'] as const;
const priced = services.map((s) => {
  const durations = [s.durationS, s.durationM, s.durationL, s.durationXl].filter(
    (n): n is number => n != null,
  );
  const min = durations.length ? Math.min(...durations) : (s.durationFlat ?? 60);
  const max = durations.length ? Math.max(...durations) : (s.durationFlat ?? 60);
  const duration = s.hasSizes
    ? min === max
      ? formatDuration(min)
      : `${formatDuration(min)}–${formatDuration(max)}`
    : formatDuration(s.durationFlat ?? 60);
  return {
    id: s.id,
    name: s.name,
    hasSizes: s.hasSizes,
    price: s.hasSizes
      ? 'from ' + money(Math.min(...[s.priceS, s.priceM, s.priceL, s.priceXl].filter((n): n is number => n != null)))
      : money(s.priceFlat ?? 0),
    duration,
  };
});
const btn = 'mt-4 rounded-full bg-brand-600 px-6 py-2.5 text-sm font-bold text-white transition hover:bg-brand-700 disabled:opacity-40 disabled:cursor-not-allowed';
const backBtn = 'mt-4 rounded-full border border-stone-300 px-5 py-2.5 text-sm font-bold text-stone-600 transition hover:bg-stone-50';
---

<div id="wizard" class="mt-8 space-y-6">
  <fieldset id="step-dogs" class="pt-6">
    <legend class="px-1 text-lg font-extrabold text-stone-900">1. Your dog(s)</legend>
    <p class="mt-1 text-sm text-stone-500">Booking more than one dog? Add each dog here — we'll reserve enough time for all of them, one after another.</p>
    <div id="dog-rows" class="mt-3 space-y-4"></div>

    <template id="dog-row-template">
      <div data-dog-row class="rounded-xl border-2 border-stone-200 bg-white p-4">
        <div class="flex items-center justify-between gap-3">
          <p data-dog-title class="font-extrabold text-stone-800">Dog 1</p>
          <button type="button" data-remove-dog class="text-sm font-bold text-red-500 hover:text-red-700">Remove</button>
        </div>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <div>
            <label class="text-sm font-bold text-stone-700">Dog's name *</label>
            <input name="dog_name" required class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2" />
          </div>
          <div>
            <label class="text-sm font-bold text-stone-700">Breed</label>
            <input name="dog_breed" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2" />
          </div>
          <div>
            <label class="text-sm font-bold text-stone-700">Service *</label>
            <select name="service" required class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2">
              <option value="">Choose a service…</option>
              {priced.map((s) => <option value={s.id}>{s.name} — {s.price} · {s.duration}</option>)}
            </select>
          </div>
          <div>
            <label class="text-sm font-bold text-stone-700">Size *</label>
            <select name="size" class="mt-1 hidden w-full rounded-lg border border-stone-300 px-3 py-2">
              <option value="">Choose a size…</option>
              {sizes.map((z) => <option value={z}>{sizeLabels[z]}</option>)}
            </select>
          </div>
          <p data-dog-duration class="hidden text-sm font-semibold text-brand-700 sm:col-span-2"></p>
        </div>
      </div>
    </template>

    <button type="button" id="add-dog" class="mt-3 rounded-full border border-stone-300 px-5 py-2 text-sm font-bold text-stone-600 transition hover:bg-stone-50">+ Add another dog</button>
    <div>
      <button type="button" id="next-dogs" disabled class={btn}>Next</button>
    </div>
  </fieldset>

  <fieldset id="step-date" class="hidden pt-6">
    <legend class="px-1 text-lg font-extrabold text-stone-900">2. Choose a day</legend>
    <div class="mt-3 flex items-center justify-between">
      <button type="button" id="cal-prev" class="rounded-full border border-stone-300 px-3 py-1.5 text-stone-600 transition hover:bg-stone-50" aria-label="Previous month">&lsaquo;</button>
      <span id="cal-month" class="font-bold text-stone-800"></span>
      <button type="button" id="cal-next" class="rounded-full border border-stone-300 px-3 py-1.5 text-stone-600 transition hover:bg-stone-50" aria-label="Next month">&rsaquo;</button>
    </div>
    <div class="mt-2 grid grid-cols-7 gap-1 text-center text-xs font-bold text-stone-400">
      <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
    </div>
    <div id="cal-grid" class="mt-1 grid grid-cols-7 gap-1"></div>
    <p id="cal-hint" class="mt-2 hidden text-sm text-stone-500">No openings in this month — try another month.</p>
    <div class="flex gap-3">
      <button type="button" id="back-to-dogs" class={backBtn}>&larr; Back</button>
      <button type="button" id="next-date" disabled class={btn}>Next</button>
    </div>
  </fieldset>

  <fieldset id="step-slot" class="hidden pt-6">
    <legend class="px-1 text-lg font-extrabold text-stone-900">3. Choose a time</legend>
    <div id="slot-grid" class="mt-3 flex flex-wrap gap-2"></div>
    <p id="slot-empty" class="mt-3 hidden text-sm text-stone-500">No times available on this day — go back and try another day.</p>
    <div class="flex gap-3">
      <button type="button" id="back-to-date" class={backBtn}>&larr; Back</button>
      <button type="button" id="next-slot" disabled class={btn}>Next</button>
    </div>
  </fieldset>

  <fieldset id="step-details" class="hidden pt-6">
    <legend class="px-1 text-lg font-extrabold text-stone-900">4. Your details</legend>
    <div class="mt-3 rounded-xl bg-brand-50 p-4 text-sm text-brand-900">
      <p class="font-bold">Your booking</p>
      <p id="selected-dogs" class="mt-1"></p>
      <p id="selected-duration" class="mt-1 font-bold"></p>
    </div>
    <form id="booking-form" class="mt-3 grid gap-4 sm:grid-cols-2">
      <input type="hidden" name="start" id="f-start" />
      <input type="hidden" name="dogs" id="f-dogs" />

      <div class="sm:col-span-2">
        <p class="text-sm font-bold text-stone-700">Add-ons <span class="font-normal text-stone-500">(applied to each dog)</span></p>
        <div class="mt-2 grid gap-2 sm:grid-cols-2">
          {addons.map((a) => (
            <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-stone-200 px-3 py-2 text-sm">
              <input type="checkbox" name="addon" value={a.id} class="accent-brand-600" />
              <span class="flex-1">{a.name}</span>
              <span class="font-bold text-brand-700">{money(a.priceCents)}</span>
            </label>
          ))}
        </div>
      </div>

      <div class="sm:col-span-2">
        <label class="text-sm font-bold text-stone-700" for="address">Address *</label>
        <input id="address" name="address" required placeholder="Street address" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2" />
      </div>
      <div>
        <label class="text-sm font-bold text-stone-700" for="suburb">Suburb *</label>
        <input id="suburb" name="suburb" required class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2" />
      </div>
      <div class="flex items-end text-xs text-stone-500">
        Mobile service — free within 10&nbsp;km of Berwick; a travel fee may apply further out.
      </div>

      <div>
        <label class="text-sm font-bold text-stone-700" for="customer_name">Your name *</label>
        <input id="customer_name" name="customer_name" required class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2" />
      </div>
      <div>
        <label class="text-sm font-bold text-stone-700" for="customer_phone">Phone *</label>
        <input id="customer_phone" name="customer_phone" required type="tel" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2" />
      </div>
      <div class="sm:col-span-2">
        <label class="text-sm font-bold text-stone-700" for="customer_email">Email *</label>
        <input id="customer_email" name="customer_email" required type="email" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2" />
      </div>
      <div class="sm:col-span-2">
        <label class="text-sm font-bold text-stone-700" for="notes">Notes for Alisha</label>
        <textarea id="notes" name="notes" rows="3" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2" placeholder="Matted coat, nervous dog, behavioural quirks, parking…"></textarea>
      </div>

      <div class="sm:col-span-2">
        <label class="flex items-start gap-2 text-sm text-stone-600">
          <input type="checkbox" name="agree" required class="mt-0.5 accent-brand-600" />
          <span>I agree to the <a href="/terms" target="_blank" rel="noopener" class="underline underline-offset-2 text-brand-600 hover:text-brand-800">Terms &amp; Conditions</a>.</span>
        </label>
      </div>

      <div class="sm:col-span-2">
        <div class="flex items-center justify-between gap-3">
          <button type="button" id="back-to-slot" class={backBtn}>&larr; Back</button>
          <button type="submit" class="rounded-full bg-brand-600 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-brand-700">Send booking request</button>
        </div>
        <p id="form-error" class="mt-3 hidden text-sm font-semibold text-red-600"></p>
      </div>
    </form>
  </fieldset>
</div>

<script is:inline define:vars={{ services, preselect }}>
const $ = (sel) => document.querySelector(sel);
const $$ = (sel) => [...document.querySelectorAll(sel)];
const state = { date: null, start: null };

const steps = { dogs: $('#step-dogs'), date: $('#step-date'), slot: $('#step-slot'), details: $('#step-details') };
const rowsEl = $('#dog-rows'), tpl = $('#dog-row-template');
const slotGrid = $('#slot-grid'), slotEmpty = $('#slot-empty'), formError = $('#form-error');
const calGrid = $('#cal-grid'), calMonthLabel = $('#cal-month'), calHint = $('#cal-hint');
const nextDogs = $('#next-dogs'), nextDate = $('#next-date'), nextSlot = $('#next-slot');

const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
let calYear, calMonth;
const calDays = new Map();

function melParts() {
  const p = new Intl.DateTimeFormat('en-CA', { timeZone: 'Australia/Melbourne', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date()).split('-');
  return { y: Number(p[0]), m: Number(p[1]) - 1, d: Number(p[2]) };
}
function resetMonth() { const n = melParts(); calYear = n.y; calMonth = n.m; }

function showStep(name) {
  Object.keys(steps).forEach((k) => steps[k].classList.add('hidden'));
  steps[name].classList.remove('hidden');
  steps[name].scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function dogRows() { return $$('[data-dog-row]'); }
function rowService(row) {
  const value = Number(row.querySelector('[name="service"]').value);
  return services.find((s) => s.id === value) || null;
}

function clearAppointment() {
  state.date = null;
  state.start = null;
  $('#f-start').value = '';
  nextDate.disabled = true;
}

function fmtDuration(minutes) {
  const total = Math.max(0, Math.round(minutes));
  const hours = Math.floor(total / 60);
  const mins = total % 60;
  return [hours ? hours + 'h' : '', mins ? mins + 'm' : ''].filter(Boolean).join(' ') || '0m';
}

function durationForRow(row) {
  const svc = rowService(row);
  if (!svc) return 0;
  if (!svc.hasSizes) return svc.durationFlat ?? 60;
  const size = row.querySelector('[name="size"]').value;
  return {
    small: svc.durationS,
    medium: svc.durationM,
    large: svc.durationL,
    xl: svc.durationXl,
  }[size] ?? 0;
}

function syncDuration(row) {
  const el = row.querySelector('[data-dog-duration]');
  const minutes = durationForRow(row);
  if (!el) return;
  el.textContent = minutes ? 'Groom time: ' + fmtDuration(minutes) : '';
  el.classList.toggle('hidden', !minutes);
}

function syncRow(row) {
  const svc = rowService(row);
  const size = row.querySelector('[name="size"]');
  size.classList.toggle('hidden', !svc || !svc.hasSizes);
  if (!svc || !svc.hasSizes) size.value = '';
  syncDuration(row);
}

function rowsAreValid() {
  return dogRows().every((row) => {
    const name = row.querySelector('[name="dog_name"]').value.trim();
    const svc = rowService(row);
    if (!name || !svc) return false;
    if (svc.hasSizes && !row.querySelector('[name="size"]').value) return false;
    return true;
  });
}

function refreshRows() {
  const rows = dogRows();
  rows.forEach((row, i) => {
    row.querySelector('[data-dog-title]').textContent = 'Dog ' + (i + 1);
    row.querySelector('[data-remove-dog]').classList.toggle('hidden', rows.length === 1);
    syncDuration(row);
  });
  nextDogs.disabled = !rowsAreValid();
}

function dogData() {
  return dogRows().map((row) => {
    const svc = rowService(row);
    return {
      name: row.querySelector('[name="dog_name"]').value.trim(),
      breed: row.querySelector('[name="dog_breed"]').value.trim(),
      service: svc ? svc.id : 0,
      size: row.querySelector('[name="size"]').value || null,
    };
  });
}

function dogQuery() {
  const query = new URLSearchParams();
  dogData().forEach((dog) => {
    query.append('service', String(dog.service));
    query.append('size', dog.size || '');
  });
  return query;
}

function bindRow(row) {
  row.querySelector('[name="service"]').addEventListener('change', () => {
    syncRow(row);
    clearAppointment();
    refreshRows();
  });
  row.querySelector('[name="dog_name"]').addEventListener('input', refreshRows);
  row.querySelector('[name="size"]').addEventListener('change', () => {
    syncDuration(row);
    clearAppointment();
    refreshRows();
  });
  row.querySelector('[data-remove-dog]').addEventListener('click', () => {
    row.remove();
    clearAppointment();
    refreshRows();
  });
}

function addRow() {
  const fragment = tpl.content.cloneNode(true);
  const row = fragment.querySelector('[data-dog-row]');
  rowsEl.appendChild(fragment);
  bindRow(row);
  refreshRows();
  return row;
}

async function loadSlots() {
  const query = dogQuery();
  query.set('date', state.date);
  slotGrid.innerHTML = '';
  slotEmpty.classList.add('hidden');
  nextSlot.disabled = true;
  const res = await fetch('/api/slots?' + query.toString());
  const data = await res.json();
  const fmt = new Intl.DateTimeFormat('en-AU', { timeZone: 'Australia/Melbourne', hour: 'numeric', minute: '2-digit' });
  if (!data.slots || !data.slots.length) { slotEmpty.classList.remove('hidden'); return; }
  data.slots.forEach((s) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'rounded-xl border-2 border-stone-200 px-5 py-2.5 text-sm font-bold text-stone-700 transition hover:border-brand-400';
    b.textContent = fmt.format(new Date(s.start));
    b.addEventListener('click', () => {
      state.start = s.start;
      slotGrid.querySelectorAll('button').forEach((x) => x.classList.remove('border-brand-500', 'bg-brand-50'));
      b.classList.add('border-brand-500', 'bg-brand-50');
      $('#f-start').value = s.start;
      nextSlot.disabled = false;
    });
    slotGrid.appendChild(b);
  });
}

async function loadCalendar() {
  const query = dogQuery();
  query.set('month', calYear + '-' + String(calMonth + 1).padStart(2, '0'));
  calDays.clear();
  const res = await fetch('/api/availability?' + query.toString());
  const data = await res.json();
  (data.days || []).forEach((dd) => calDays.set(dd.date, dd.slots));
  renderCalendar();
}

function renderCalendar() {
  calMonthLabel.textContent = MONTHS[calMonth] + ' ' + calYear;
  calGrid.innerHTML = '';
  const today = melParts();
  const todayStr = String(today.y) + '-' + String(today.m + 1).padStart(2, '0') + '-' + String(today.d).padStart(2, '0');
  const offset = (new Date(Date.UTC(calYear, calMonth, 1)).getUTCDay() + 6) % 7; // Monday-first
  const dim = new Date(Date.UTC(calYear, calMonth + 1, 0)).getUTCDate();
  let any = false;
  for (let i = 0; i < offset; i++) calGrid.appendChild(document.createElement('div'));
  for (let d = 1; d <= dim; d++) {
    const ds = calYear + '-' + String(calMonth + 1).padStart(2, '0') + '-' + String(d).padStart(2, '0');
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.dataset.date = ds;
    btn.textContent = String(d);
    const avail = (calDays.get(ds) || 0) > 0 && ds >= todayStr;
    btn.className = 'rounded-lg py-2 text-sm font-bold transition ' +
      (avail ? 'bg-brand-50 text-brand-800 hover:bg-brand-100 aria-checked:bg-brand-500 aria-checked:text-white' : 'cursor-not-allowed text-stone-300');
    if (avail) {
      if (ds === state.date) btn.setAttribute('aria-checked', 'true');
      btn.addEventListener('click', () => {
        state.date = ds;
        state.start = null;
        $('#f-start').value = '';
        calGrid.querySelectorAll('button[data-date]').forEach((b) => b.removeAttribute('aria-checked'));
        btn.setAttribute('aria-checked', 'true');
        nextDate.disabled = false;
      });
      any = true;
    }
    calGrid.appendChild(btn);
  }
  calHint.classList.toggle('hidden', any);
}

function enterDateStep() {
  showStep('date');
  loadCalendar();
}

function renderSummary() {
  const parts = dogData().map((dog) => {
    const svc = services.find((s) => s.id === dog.service);
    const size = dog.size ? ` (${dog.size})` : '';
    return `${dog.name} — ${svc ? svc.name : ''}${size}`;
  });
  $('#selected-dogs').textContent = parts.join(' · ');
  const total = dogRows().reduce((sum, row) => sum + durationForRow(row), 0);
  $('#selected-duration').textContent = total ? 'Total appointment time: ' + fmtDuration(total) : '';
}

$('#add-dog').addEventListener('click', () => {
  addRow();
  clearAppointment();
});

nextDogs.addEventListener('click', () => {
  resetMonth();
  clearAppointment();
  enterDateStep();
});

$('#cal-prev').addEventListener('click', () => {
  calMonth--;
  if (calMonth < 0) { calMonth = 11; calYear--; }
  loadCalendar();
});
$('#cal-next').addEventListener('click', () => {
  calMonth++;
  if (calMonth > 11) { calMonth = 0; calYear++; }
  loadCalendar();
});

nextDate.addEventListener('click', async () => { await loadSlots(); showStep('slot'); });

nextSlot.addEventListener('click', () => {
  $('#f-dogs').value = JSON.stringify(dogData());
  renderSummary();
  showStep('details');
});

$('#back-to-dogs').addEventListener('click', () => showStep('dogs'));
$('#back-to-date').addEventListener('click', () => showStep('date'));
$('#back-to-slot').addEventListener('click', () => showStep('slot'));

$('#booking-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  if (!state.start) return;
  formError.classList.add('hidden');
  const form = e.target;
  $('#f-dogs').value = JSON.stringify(dogData());
  const res = await fetch('/api/bookings', { method: 'POST', body: new FormData(form) });
  const data = await res.json();
  if (data.ok) {
    window.location.href = data.redirect;
  } else {
    formError.textContent = data.error || 'Something went wrong. Please try again.';
    formError.classList.remove('hidden');
  }
});

addRow();
resetMonth();

if (preselect) {
  const svc = services.find((s) => s.slug === preselect);
  if (svc) {
    const first = dogRows()[0];
    first.querySelector('[name="service"]').value = String(svc.id);
    syncRow(first);
    refreshRows();
  }
}
</script>
