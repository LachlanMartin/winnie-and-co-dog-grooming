---
import { money } from '../lib/money';
import { formatDuration } from '../lib/duration';
import { dateStr } from '../lib/tz';

interface Props {
  services: {
    id: number; name: string; hasSizes: boolean;
    priceFlat: number | null; priceS: number | null; priceM: number | null;
    priceL: number | null; priceXl: number | null;
    durationFlat: number | null; durationS: number | null; durationM: number | null;
    durationL: number | null; durationXl: number | null;
  }[];
  addons: { id: number; name: string; priceCents: number }[];
  sizeLabels: Record<string, string>;
  returnTo?: string;
  prefillHint?: boolean;
}
const { services, addons, sizeLabels, returnTo = '/admin?tab=bookings', prefillHint = false } = Astro.props;
const sizes = ['small', 'medium', 'large', 'xl'] as const;
const priced = services.map((s) => {
  const durations = [s.durationS, s.durationM, s.durationL, s.durationXl].filter(
    (n): n is number => n != null,
  );
  const min = durations.length ? Math.min(...durations) : (s.durationFlat ?? 60);
  const max = durations.length ? Math.max(...durations) : (s.durationFlat ?? 60);
  const duration = s.hasSizes
    ? min === max
      ? formatDuration(min)
      : `${formatDuration(min)}–${formatDuration(max)}`
    : formatDuration(s.durationFlat ?? 60);
  return {
    id: s.id,
    name: s.name,
    hasSizes: s.hasSizes,
    price: s.hasSizes
      ? 'from ' + money(Math.min(...[s.priceS, s.priceM, s.priceL, s.priceXl].filter((n): n is number => n != null)))
      : money(s.priceFlat ?? 0),
    duration,
    durationFlat: s.durationFlat ?? '',
    durationS: s.durationS ?? '',
    durationM: s.durationM ?? '',
    durationL: s.durationL ?? '',
    durationXl: s.durationXl ?? '',
  };
});
const today = dateStr(new Date());
---

<details id="admin-create-booking" class="rounded-2xl border border-stone-200/80 bg-white p-5 shadow-sm">
  <summary class="flex cursor-pointer list-none items-center gap-2 text-sm font-extrabold text-brand-700 transition hover:text-brand-800 [&::-webkit-details-marker]:hidden">
    <span class="grid h-7 w-7 place-items-center rounded-full bg-brand-600 text-base font-bold leading-none text-white shadow-sm shadow-brand-600/20">+</span>
    Create booking
  </summary>
  <p class="mt-2 pl-9 text-sm leading-6 text-stone-500">
    {prefillHint ? 'Click an open time in the calendar to fill the date and start time, or enter them here.' : "For phone or message bookings. It's confirmed immediately and the customer gets a confirmation email."}
  </p>

  <form id="admin-booking-form" method="POST" action="/api/admin/bookings" class="mt-4 grid gap-3 sm:grid-cols-2">
    <input type="hidden" name="dogs" />
    <input type="hidden" name="return_to" value={returnTo} />

    <div>
      <label class="text-xs font-bold text-stone-600">Customer</label>
      <input name="customer_name" required class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm" />
    </div>
    <div>
      <label class="text-xs font-bold text-stone-600">Phone</label>
      <input name="customer_phone" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm" />
    </div>
    <div>
      <label class="text-xs font-bold text-stone-600">Email</label>
      <input name="customer_email" type="email" required class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm" />
    </div>
    <div>
      <label class="text-xs font-bold text-stone-600">Suburb</label>
      <input name="suburb" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm" />
    </div>
    <div class="sm:col-span-2">
      <label class="text-xs font-bold text-stone-600">Address</label>
      <input name="address" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm" />
    </div>

    <div class="sm:col-span-2">
      <p class="text-sm font-bold text-stone-700">Dogs</p>
      <div id="admin-dog-rows" class="mt-2 space-y-2"></div>
      <template id="admin-dog-template">
        <div data-admin-dog class="flex flex-wrap items-center gap-2 rounded-lg bg-stone-50 p-2">
          <input name="dog_name" placeholder="Dog name" required aria-label="Dog name" class="min-w-0 flex-1 rounded-lg border border-stone-300 px-3 py-2 text-sm" />
          <input name="dog_breed" placeholder="Breed" aria-label="Breed" class="min-w-0 flex-1 rounded-lg border border-stone-300 px-3 py-2 text-sm" />
          <select name="service" required aria-label="Service" class="rounded-lg border border-stone-300 px-2 py-2 text-sm">
            <option value="">Service…</option>
            {priced.map((s) => (
              <option
                value={s.id}
                data-sizes={s.hasSizes ? '1' : ''}
                data-flat-duration={s.durationFlat}
                data-small-duration={s.durationS}
                data-medium-duration={s.durationM}
                data-large-duration={s.durationL}
                data-xl-duration={s.durationXl}
              >{s.name} — {s.price} · {s.duration}</option>
            ))}
          </select>
          <select name="size" aria-label="Size" class="hidden rounded-lg border border-stone-300 px-2 py-2 text-sm">
            <option value="">Size…</option>
            {sizes.map((z) => <option value={z}>{sizeLabels[z]}</option>)}
          </select>
          <span data-admin-dog-duration class="w-full text-xs font-semibold text-brand-700"></span>
          <button type="button" data-remove-dog class="text-sm font-bold text-red-500 hover:text-red-700">Remove</button>
        </div>
      </template>
      <button type="button" id="admin-add-dog" class="mt-2 rounded-xl border border-stone-200 bg-white px-4 py-2 text-sm font-bold text-stone-600 shadow-sm transition hover:border-stone-300 hover:bg-stone-50 active:scale-[.98]">+ Add another dog</button>
      <p id="admin-total-duration" class="mt-2 text-xs font-bold text-brand-700"></p>
    </div>

    <div>
      <label class="text-xs font-bold text-stone-600">Date</label>
      <input id="admin-new-date" name="date" type="date" min={today} required class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm" />
    </div>
    <div>
      <label class="text-xs font-bold text-stone-600">First dog starts</label>
      <input id="admin-new-time" name="time" type="time" required class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm" />
    </div>

    <div class="sm:col-span-2">
      <p class="text-xs font-bold text-stone-600">Add-ons (applied to each dog)</p>
      <div class="mt-2 flex flex-wrap gap-2">
        {addons.map((a) => (
          <label class="flex items-center gap-2 rounded-xl border border-stone-200 bg-stone-50/50 px-3 py-2 text-sm text-stone-600">
            <input type="checkbox" name="addon" value={a.id} class="accent-brand-600" />
            {a.name} <span class="font-bold text-brand-700">{money(a.priceCents)}</span>
          </label>
        ))}
      </div>
    </div>

    <div class="sm:col-span-2">
      <label class="text-xs font-bold text-stone-600">Notes</label>
      <input name="notes" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm" />
    </div>

    <div class="sm:col-span-2">
      <button class="rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-bold text-white shadow-sm shadow-brand-600/20 transition hover:bg-brand-700 active:scale-[.98]">Create confirmed booking</button>
    </div>
  </form>
</details>
<script>
const rows = document.getElementById('admin-dog-rows') as HTMLElement;
const template = document.getElementById('admin-dog-template') as HTMLTemplateElement;

function dogRows(): HTMLElement[] {
  return [...document.querySelectorAll<HTMLElement>('[data-admin-dog]')];
}
function serviceHasSizes(row: HTMLElement): boolean {
  const select = row.querySelector<HTMLSelectElement>('[name="service"]');
  const option = select?.selectedOptions[0];
  return option?.dataset.sizes === '1';
}
function syncRow(row: HTMLElement) {
  const size = row.querySelector<HTMLSelectElement>('[name="size"]');
  if (!size) return;
  const hasSizes = serviceHasSizes(row);
  size.classList.toggle('hidden', !hasSizes);
  if (!hasSizes) size.value = '';
}
function fmtDuration(minutes: number): string {
  const total = Math.max(0, Math.round(minutes));
  const hours = Math.floor(total / 60);
  const mins = total % 60;
  return [hours ? `${hours}h` : '', mins ? `${mins}m` : ''].filter(Boolean).join(' ') || '0m';
}
function durationForRow(row: HTMLElement): number {
  const select = row.querySelector<HTMLSelectElement>('[name="service"]');
  const option = select?.selectedOptions[0];
  if (!option?.value) return 0;
  if (option.dataset.sizes === '1') {
    const size = row.querySelector<HTMLSelectElement>('[name="size"]')?.value;
    return size ? Number(option.dataset[`${size}Duration`] ?? 0) : 0;
  }
  return Number(option.dataset.flatDuration ?? 0);
}
function syncDuration(row: HTMLElement) {
  const el = row.querySelector<HTMLElement>('[data-admin-dog-duration]');
  if (!el) return;
  const minutes = durationForRow(row);
  el.textContent = minutes ? `Groom time: ${fmtDuration(minutes)}` : '';
}
function refresh() {
  const all = dogRows();
  let total = 0;
  all.forEach((row) => {
    row.querySelector('[data-remove-dog]')?.classList.toggle('hidden', all.length === 1);
    syncDuration(row);
    total += durationForRow(row);
  });
  const totalEl = document.getElementById('admin-total-duration');
  if (totalEl) totalEl.textContent = total ? `Total visit: ${fmtDuration(total)}` : '';
}
function addRow() {
  const fragment = template.content.cloneNode(true) as DocumentFragment;
  const row = fragment.querySelector<HTMLElement>('[data-admin-dog]');
  if (!row) return;
  rows.appendChild(fragment);
  row.querySelector('[name="service"]')?.addEventListener('change', () => {
    syncRow(row);
    refresh();
  });
  row.querySelector('[name="size"]')?.addEventListener('change', refresh);
  row.querySelector('[data-remove-dog]')?.addEventListener('click', () => {
    row.remove();
    refresh();
  });
  refresh();
  return row;
}

document.getElementById('admin-add-dog')?.addEventListener('click', () => addRow());

document.getElementById('admin-booking-form')?.addEventListener('submit', (event) => {
  const found = dogRows();
  const dogs = found.map((row) => {
    const name = row.querySelector<HTMLInputElement>('[name="dog_name"]');
    const breed = row.querySelector<HTMLInputElement>('[name="dog_breed"]');
    const service = row.querySelector<HTMLSelectElement>('[name="service"]');
    const size = row.querySelector<HTMLSelectElement>('[name="size"]');
    return {
      name: name?.value.trim() ?? '',
      breed: breed?.value.trim() ?? '',
      service: Number(service?.value ?? 0),
      size: size?.value || null,
    };
  });
  const invalid = dogs.some((dog, i) => !dog.name || !dog.service || (serviceHasSizes(found[i]) && !dog.size));
  if (!dogs.length || invalid) {
    event.preventDefault();
    alert('Please enter a name and choose a service and size for each dog.');
    return;
  }
  const hidden = document.querySelector<HTMLInputElement>('#admin-booking-form [name="dogs"]');
  if (hidden) hidden.value = JSON.stringify(dogs);
});

addRow();
</script>
