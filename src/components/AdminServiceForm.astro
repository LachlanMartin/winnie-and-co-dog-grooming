---
import type { Service } from '../../db/schema';
import { SIZE_LABELS } from '../lib/availability';

interface Props {
  service?: Service;
  defaultSortOrder?: number;
  submitLabel: string;
}
const { service, defaultSortOrder = 0, submitLabel } = Astro.props;
const sizeFields = [
  { size: 'small', key: 's', price: service?.priceS, duration: service?.durationS },
  { size: 'medium', key: 'm', price: service?.priceM, duration: service?.durationM },
  { size: 'large', key: 'l', price: service?.priceL, duration: service?.durationL },
  { size: 'xl', key: 'xl', price: service?.priceXl, duration: service?.durationXl },
] as const;
const dollars = (cents: number | null | undefined) =>
  cents == null ? '' : (cents / 100).toFixed(2);
---

<form method="POST" action="/api/admin/services" data-service-form class="mt-3 grid gap-4">
  {service ? (
    <>
      <input type="hidden" name="action" value="save" />
      <input type="hidden" name="id" value={service.id} />
    </>
  ) : (
    <input type="hidden" name="action" value="create" />
  )}

  <div class="grid gap-3 sm:grid-cols-2">
    <div>
      <label class="text-xs font-bold text-stone-600">Service name</label>
      <input name="name" value={service?.name ?? ''} required class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm" />
    </div>
    <div>
      <label class="text-xs font-bold text-stone-600">Sort order</label>
      <input name="sort_order" type="number" min="0" step="1" value={service?.sortOrder ?? defaultSortOrder} class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm" />
    </div>
  </div>

  <div>
    <label class="text-xs font-bold text-stone-600">Description</label>
    <textarea name="description" rows="3" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm">{service?.description ?? ''}</textarea>
  </div>

  <div class="flex flex-wrap items-center gap-5 rounded-xl bg-stone-50 px-4 py-3">
    <label class="flex items-center gap-2 text-sm font-bold text-stone-700">
      <input type="checkbox" name="hasSizes" checked={service?.hasSizes ?? false} class="accent-brand-600" />
      Price and duration vary by dog size
    </label>
    <label class="flex items-center gap-2 text-sm font-bold text-stone-700">
      <input type="checkbox" name="active" checked={service?.active ?? true} class="accent-brand-600" />
      Available to book
    </label>
  </div>

  <div data-flat-fields class={service?.hasSizes ? 'hidden' : ''}>
    <div class="grid gap-3 rounded-xl border border-stone-200 bg-white p-4 sm:grid-cols-2">
      <div>
        <label class="text-xs font-bold text-stone-600">Price ($)</label>
        <input name="price_flat" type="number" min="0" step="0.01" inputmode="decimal" value={dollars(service?.priceFlat)} class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm" />
      </div>
      <div>
        <label class="text-xs font-bold text-stone-600">Duration (minutes)</label>
        <input name="duration_flat" type="number" min="1" step="1" value={service?.durationFlat ?? ''} class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm" />
      </div>
    </div>
  </div>

  <div data-size-fields class={service?.hasSizes ? '' : 'hidden'}>
    <div class="grid gap-2">
      {sizeFields.map((item) => (
        <div class="grid gap-3 rounded-xl border border-stone-200 bg-white p-4 sm:grid-cols-[1fr_140px_160px] sm:items-end">
          <p class="text-sm font-bold text-stone-700">{SIZE_LABELS[item.size]}</p>
          <div>
            <label class="text-xs font-bold text-stone-600">Price ($)</label>
            <input name={`price_${item.key}`} type="number" min="0" step="0.01" inputmode="decimal" value={dollars(item.price)} class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm" />
          </div>
          <div>
            <label class="text-xs font-bold text-stone-600">Duration (min)</label>
            <input name={`duration_${item.key}`} type="number" min="1" step="1" value={item.duration ?? ''} class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm" />
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="flex items-center gap-3">
    <button class="rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-bold text-white shadow-sm shadow-brand-600/20 transition hover:bg-brand-700 active:scale-[.98]">{submitLabel}</button>
    <p class="text-xs text-stone-500">Prices and durations apply to new bookings only.</p>
  </div>
</form>
