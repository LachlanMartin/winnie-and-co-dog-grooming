---
interface Props {
  addon?: {
    id: number;
    name: string;
    priceCents: number;
    active: boolean;
    sortOrder: number;
  };
  defaultSortOrder?: number;
  submitLabel: string;
}
const { addon, defaultSortOrder = 0, submitLabel } = Astro.props;
const dollars = (cents: number | undefined) =>
  cents == null ? '' : (cents / 100).toFixed(2);
---

<form method="POST" action="/api/admin/addons" class="mt-3 grid gap-3 sm:grid-cols-[1fr_120px_100px_auto] sm:items-end">
  {addon ? (
    <>
      <input type="hidden" name="action" value="save" />
      <input type="hidden" name="id" value={addon.id} />
    </>
  ) : (
    <input type="hidden" name="action" value="create" />
  )}
  <div>
    <label class="text-xs font-bold text-stone-600">Add-on name</label>
    <input name="name" value={addon?.name ?? ''} required class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm" />
  </div>
  <div>
    <label class="text-xs font-bold text-stone-600">Price ($)</label>
    <input name="price" type="number" min="0" step="0.01" inputmode="decimal" value={dollars(addon?.priceCents)} class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm" />
  </div>
  <div>
    <label class="text-xs font-bold text-stone-600">Order</label>
    <input name="sort_order" type="number" min="0" step="1" value={addon?.sortOrder ?? defaultSortOrder} class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm" />
  </div>
  <div class="flex flex-wrap items-center gap-3 pb-1">
    <label class="flex items-center gap-2 whitespace-nowrap text-sm font-bold text-stone-700">
      <input type="checkbox" name="active" checked={addon?.active ?? true} class="accent-brand-600" />
      Available
    </label>
    <button class="rounded-xl bg-brand-600 px-4 py-2 text-sm font-bold text-white shadow-sm shadow-brand-600/20 transition hover:bg-brand-700 active:scale-[.98]">{submitLabel}</button>
  </div>
</form>
