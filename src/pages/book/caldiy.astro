---
import Base from '../../layouts/Base.astro';

const configuredUrl = (import.meta.env.CALDIY_BOOKING_URL ?? '').trim();

let bookingUrl: URL | null = null;
if (configuredUrl) {
  try {
    const parsed = new URL(configuredUrl);
    if (parsed.protocol === 'http:' || parsed.protocol === 'https:') bookingUrl = parsed;
  } catch {
    bookingUrl = null;
  }
}

const bookingHref = bookingUrl?.toString() ?? '';
const embedOrigin = bookingUrl?.origin ?? '';
const embedLink = bookingUrl?.pathname.replace(/^\/+/, '') ?? '';
const isConfigured = Boolean(bookingHref && embedOrigin && embedLink);
---

<Base
  title="Cal.diy booking preview · Winnie & Co Dog Grooming"
  description="Preview of the Cal.diy booking experience for Winnie & Co."
>
  <section class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <a href="/book" class="text-sm font-semibold text-brand-600 hover:text-brand-800">
        &larr; Current booking flow
      </a>
      <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-extrabold uppercase tracking-wide text-amber-800">
        Local preview
      </span>
    </div>

    <h1 class="mt-2 text-3xl font-black text-stone-900">Book a groom</h1>
    <p class="mt-1 max-w-2xl text-stone-600">
      This page previews the Cal.diy booking experience. It is separate from the current request flow
      and does not create bookings or invoices in this app.
    </p>

    {isConfigured ? (
      <>
        <div class="mt-5 flex flex-wrap items-center gap-3 rounded-xl border border-brand-200 bg-brand-50 px-4 py-3 text-sm text-brand-900">
          <p class="min-w-0 flex-1">
            Using the Cal.diy event configured in
            <code class="font-bold">CALDIY_BOOKING_URL</code>.
          </p>
          <a
            href={bookingHref}
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 rounded-full bg-brand-600 px-4 py-2 text-sm font-bold text-white transition hover:bg-brand-700"
          >
            Open full page &rarr;
          </a>
        </div>

        <div
          id="caldiy-inline"
          class="mt-6 min-h-[720px] overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm"
        ></div>

        <p class="mt-3 text-sm text-stone-500">
          If the embedded calendar does not load, use
          <a
            href={bookingHref}
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-brand-600 underline underline-offset-2 hover:text-brand-800"
          >
            the full Cal.diy booking page
          </a>
          instead. Bookings made there are handled by Cal.diy, not this site.
        </p>
      </>
    ) : (
      <div class="mt-6 rounded-2xl border border-amber-200 bg-amber-50 p-5 text-amber-900">
        <p class="font-extrabold">Preview not configured</p>
        <p class="mt-1 text-sm">
          Set <code class="rounded bg-white/70 px-1.5 py-0.5 font-bold">CALDIY_BOOKING_URL</code> in
          <code class="rounded bg-white/70 px-1.5 py-0.5 font-bold">.env</code> to a Cal.diy event URL,
          then restart the dev server.
        </p>
        <pre class="mt-3 overflow-x-auto rounded-xl bg-white/80 p-3 text-xs font-semibold"><code>CALDIY_BOOKING_URL=http://localhost:3000/alisha/30min</code></pre>
        <p class="mt-3 text-sm">
          The URL should point at a booking link on your self-hosted Cal.diy instance. See the README
          for the local test steps.
        </p>
        <a
          href="/book"
          class="mt-4 inline-block rounded-full bg-brand-600 px-4 py-2 text-sm font-bold text-white transition hover:bg-brand-700"
        >
          Use the current booking flow &rarr;
        </a>
      </div>
    )}
  </section>

  <script is:inline define:vars={{ isConfigured, embedOrigin, embedLink }}>
    if (isConfigured) {
      (function (C, A, L) {
        let p = function (a, ar) {
          a.q.push(ar);
        };
        let d = C.document;
        C.Cal =
          C.Cal ||
          function () {
            let cal = C.Cal;
            let ar = arguments;
            if (!cal.loaded) {
              cal.ns = {};
              cal.q = cal.q || [];
              d.head.appendChild(d.createElement('script')).src = A;
              cal.loaded = true;
            }
            if (ar[0] === L) {
              const api = function () {
                p(api, arguments);
              };
              const namespace = ar[1];
              api.q = api.q || [];
              if (typeof namespace === 'string') {
                cal.ns[namespace] = cal.ns[namespace] || api;
                p(cal.ns[namespace], ar);
                p(cal, ['initNamespace', namespace]);
              } else p(cal, ar);
              return;
            }
            p(cal, ar);
          };
      })(window, embedOrigin + '/embed/embed.js', 'init');

      Cal('init', { origin: embedOrigin });
      Cal('inline', {
        elementOrSelector: '#caldiy-inline',
        calLink: embedLink,
        layout: 'month_view',
      });
      Cal('ui', {
        layout: 'month_view',
        hideEventTypeDetails: false,
        cssVarsPerTheme: {
          light: { 'cal-brand': '#0789c5' },
          dark: { 'cal-brand': '#38c3f4' },
        },
      });
    }
  </script>
</Base>
