---
import { asc, ne } from 'drizzle-orm';
import { db } from '../../lib/db';
import {
  addons,
  bookings,
  blockouts,
  invoices,
  services,
  workingHours,
} from '../../../db/schema';
import { getSettings } from '../../lib/settings';
import { money } from '../../lib/money';
import { dayLabel, dateStr, timeOfDay } from '../../lib/tz';
import { durationFor, SIZE_LABELS, SIZES } from '../../lib/availability';
import type { Size } from '../../lib/availability';
import AdminBookingCard from '../../components/AdminBookingCard.astro';
import AdminCreateBooking from '../../components/AdminCreateBooking.astro';
import AdminCalendar from '../../components/AdminCalendar.astro';
import AdminServices from '../../components/AdminServices.astro';

const tab = Astro.url.searchParams.get('tab') ?? 'calendar';
const error = Astro.url.searchParams.get('error');
const saved = Astro.url.searchParams.get('saved');
const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

const [serviceRows, addonRows, hourRows, blockRows] = await Promise.all([
  db.select().from(services).orderBy(asc(services.sortOrder)),
  db.select().from(addons).orderBy(asc(addons.sortOrder)),
  db.select().from(workingHours).orderBy(asc(workingHours.dayOfWeek)),
  db.select().from(blockouts).orderBy(asc(blockouts.startAt)),
]);

const bookingRows = await db
  .select()
  .from(bookings)
  .where(ne(bookings.status, 'declined'))
  .orderBy(asc(bookings.slotStart));

const invRows = await db.select().from(invoices).orderBy(asc(invoices.number));

const serviceById = new Map(serviceRows.map((s) => [s.id, s]));
const addonById = new Map(addonRows.map((a) => [a.id, a]));

const enriched = bookingRows.map((b) => ({
  ...b,
  service: serviceById.get(b.serviceId),
  addonNames: (b.addonIds ?? []).map((id) => addonById.get(id)?.name).filter((n): n is string => !!n),
}));

const grouped = new Map<string, typeof enriched>();
for (const booking of enriched) {
  const key = booking.orderId ?? `single-${booking.id}`;
  grouped.set(key, [...(grouped.get(key) ?? []), booking]);
}
const orders = [...grouped.entries()]
  .map(([key, list]) => {
    const dogs = [...list].sort((a, b) => a.slotStart.getTime() - b.slotStart.getTime());
    return {
      key,
      bookings: dogs,
      lead: dogs[0],
      slotStart: dogs[0].slotStart,
      status: dogs.some((b) => b.status === 'pending') ? 'pending' : dogs[0].status,
    };
  })
  .sort((a, b) => a.slotStart.getTime() - b.slotStart.getTime());

const pending = orders.filter((o) => o.status === 'pending');
const upcoming = orders.filter((o) => o.status === 'confirmed' && o.slotStart > new Date());
const past = orders.filter(
  (o) => o.status === 'cancelled' || (o.status === 'confirmed' && o.slotStart <= new Date()),
);

const calendarHours = hourRows.map((h) => ({
  dayOfWeek: h.dayOfWeek,
  openTime: h.openTime.slice(0, 5),
  closeTime: h.closeTime.slice(0, 5),
}));
const calendarEvents = orders
  .filter((o) => o.status === 'pending' || o.status === 'confirmed')
  .map((o) => {
    const last = o.bookings[o.bookings.length - 1];
    return {
      id: o.key,
      title: o.bookings.map((b) => b.dogName).join(' & ') + (o.bookings.length > 1 ? ` (${o.bookings.length})` : ''),
      start: o.lead.slotStart.toISOString(),
      end: last.slotEnd.toISOString(),
      status: o.status,
      bookingId: o.lead.id,
      customerName: o.lead.customerName,
      customerEmail: o.lead.customerEmail,
      customerPhone: o.lead.customerPhone,
      address: o.lead.address,
      suburb: o.lead.suburb,
      notes: o.lead.notes,
      date: dateStr(o.lead.slotStart),
      time: timeOfDay(o.lead.slotStart),
      dogs: o.bookings.map((b) => ({
        id: b.id,
        name: b.dogName,
        breed: b.dogBreed,
        service: b.service?.name ?? 'Service',
        size: b.size ?? '',
        duration: b.service
          ? durationFor(b.service, SIZES.includes(b.size as Size) ? (b.size as Size) : null)
          : 0,
      })),
    };
  });
const calendarBlocks = blockRows.map((b) => ({
  startAt: b.startAt.toISOString(),
  endAt: b.endAt.toISOString(),
  note: b.note,
}));

const settings = await getSettings(['business_name', 'abn', 'bank_details', 'invoice_prefix']);
const statusBadge: Record<string, string> = {
  pending: 'bg-brand-100 text-brand-800',
  confirmed: 'bg-green-100 text-green-700',
  declined: 'bg-red-100 text-red-600',
  cancelled: 'bg-stone-100 text-stone-500',
};

const tabs = [
  ['calendar', 'Calendar'],
  ['bookings', 'Bookings'],
  ['services', 'Services'],
  ['hours', 'Hours'],
  ['blockouts', 'Days off'],
  ['invoices', 'Invoices'],
  ['settings', 'Settings'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <title>Admin · Winnie &amp; Co</title>
    <style>
      @import "./../../styles/global.css";

      .admin-shell input:not([type="checkbox"]):not([type="radio"]),
      .admin-shell select,
      .admin-shell textarea {
        border-radius: 0.75rem;
        border-color: #e7e5e4;
        background-color: #fff;
        box-shadow: 0 1px 2px rgb(0 0 0 / 0.02);
        transition: border-color 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
      }
      .admin-shell input:not([type="checkbox"]):not([type="radio"]):focus,
      .admin-shell select:focus,
      .admin-shell textarea:focus {
        border-color: #38c3f4;
        outline: none;
        box-shadow: 0 0 0 4px #effcff;
      }
      .admin-shell input[type="checkbox"],
      .admin-shell input[type="radio"] {
        accent-color: #0789c5;
      }
    </style>
  </head>
  <body class="admin-shell min-h-screen bg-stone-50 text-stone-800">
    <header class="sticky top-0 z-30 border-b border-stone-200/80 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
        <a href="/" class="flex items-center gap-2 font-extrabold text-brand-800">
          <span class="grid h-8 w-8 place-items-center rounded-xl bg-brand-50 text-base">🐾</span>
          <span>Winnie &amp; Co <span class="font-bold text-stone-400">/ Admin</span></span>
        </a>
        <form method="POST" action="/api/admin/logout">
          <button class="rounded-full px-3 py-1.5 text-sm font-bold text-stone-500 transition hover:bg-stone-100 hover:text-stone-800">Sign out</button>
        </form>
      </div>
      <nav class="mx-auto flex max-w-6xl gap-1 overflow-x-auto px-3 pb-3 sm:px-5">
        {tabs.map(([key, label]) => (
          <a
            href={`/admin?tab=${key}`}
            class={`whitespace-nowrap rounded-full px-4 py-2 text-sm font-bold transition ${tab === key ? 'bg-brand-600 text-white shadow-sm shadow-brand-600/20' : 'text-stone-500 hover:bg-stone-100 hover:text-stone-800'}`}
          >{label}</a>
        ))}
      </nav>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
      <!-- ============ CALENDAR ============ -->
      {tab === 'calendar' && (
        <>
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <h1 class="text-3xl font-black tracking-tight">Calendar</h1>
              <p class="mt-1 text-sm text-stone-500">
                <span class="font-bold text-amber-700">{pending.length} pending</span>
                <span class="mx-1 text-stone-300">·</span>
                <span class="font-bold text-green-700">{upcoming.length} upcoming</span>
              </p>
            </div>
            <div class="flex gap-2">
              <a href="/admin?tab=hours" class="rounded-xl border border-stone-200 bg-white px-4 py-2 text-sm font-bold text-stone-600 shadow-sm transition hover:border-stone-300 hover:bg-stone-50 active:scale-[.98]">Edit hours</a>
              <a href="/admin?tab=blockouts" class="rounded-xl border border-stone-200 bg-white px-4 py-2 text-sm font-bold text-stone-600 shadow-sm transition hover:border-stone-300 hover:bg-stone-50 active:scale-[.98]">Days off</a>
            </div>
          </div>

          {error && (
            <p class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">{error}</p>
          )}
          {saved && (
            <p class="mt-4 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-semibold text-green-700">Saved.</p>
          )}

          <AdminCalendar events={calendarEvents} workingHours={calendarHours} blockouts={calendarBlocks} />

          <div class="mt-4">
            <AdminCreateBooking
              services={serviceRows}
              addons={addonRows}
              sizeLabels={SIZE_LABELS}
              returnTo="/admin?tab=calendar"
              prefillHint
            />
          </div>
        </>
      )}

      <!-- ============ BOOKINGS ============ -->
      {tab === 'bookings' && (
        <>
          <h1 class="text-3xl font-black tracking-tight">Bookings</h1>

          {error && (
            <p class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">{error}</p>
          )}
          {saved && (
            <p class="mt-4 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-semibold text-green-700">Saved.</p>
          )}

          <div class="mt-4">
            <AdminCreateBooking services={serviceRows} addons={addonRows} sizeLabels={SIZE_LABELS} />
          </div>

          {pending.length > 0 && (
            <section class="mt-6">
              <h2 class="text-lg font-extrabold text-brand-700">Awaiting your approval ({pending.length})</h2>
              <div class="mt-3 space-y-3">
                {pending.map((o) => <AdminBookingCard bookings={o.bookings} mode="pending" />)}
              </div>
            </section>
          )}

          <section class="mt-8">
            <h2 class="text-lg font-extrabold">Upcoming ({upcoming.length})</h2>
            <div class="mt-3 space-y-3">
              {upcoming.length === 0 && <p class="text-sm text-stone-500">No confirmed upcoming bookings.</p>}
              {upcoming.map((o) => <AdminBookingCard bookings={o.bookings} mode="confirmed" />)}
            </div>
          </section>

          {past.length > 0 && (
            <section class="mt-8">
              <h2 class="text-lg font-extrabold text-stone-400">Past &amp; cancelled</h2>
              <div class="mt-3 space-y-2">
                {past.slice(0, 20).map((o) => (
                  <div class="flex items-center justify-between rounded-lg bg-white px-4 py-2 text-sm text-stone-500">
                    <span>
                      {dayLabel(o.lead.slotStart)} · {o.bookings.map((b) => b.dogName).join(' & ')} · {o.lead.service?.name}
                    </span>
                    <span class={`rounded-full px-2 py-0.5 text-xs font-bold ${statusBadge[o.status]}`}>{o.status}</span>
                  </div>
                ))}
              </div>
            </section>
          )}
        </>
      )}

      <!-- ============ SERVICES ============ -->
      {tab === 'services' && (
        <>
          {error && (
            <p class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">{error}</p>
          )}
          {saved && (
            <p class="mb-4 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-semibold text-green-700">Saved.</p>
          )}
          <AdminServices services={serviceRows} addons={addonRows} />
        </>
      )}

      <!-- ============ HOURS ============ -->
      {tab === 'hours' && (
        <>
          <h1 class="text-3xl font-black tracking-tight">Working hours</h1>
          <p class="mt-1 text-sm text-stone-500">Tick a day to enable it.</p>
          {error && (
            <p class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">{error}</p>
          )}
          {saved && (
            <p class="mt-4 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-semibold text-green-700">Saved.</p>
          )}
          <form method="POST" action="/api/admin/hours" class="mt-6 rounded-2xl border border-stone-200/80 bg-white p-6 shadow-sm">
            <div class="space-y-2">
              {DAYS.map((dayName, day) => {
                const row = hourRows.find((h) => h.dayOfWeek === day);
                return (
                  <div class="flex flex-wrap items-center gap-3 rounded-lg bg-stone-50 px-4 py-3">
                    <label class="flex w-32 items-center gap-2 font-bold text-stone-700">
                      <input type="checkbox" name={`enabled_${day}`} checked={!!row} class="accent-brand-600" />
                      {dayName}
                    </label>
                    <div class="flex items-center gap-2">
                      <input type="time" name={`open_${day}`} value={row?.openTime ?? '08:30'} class="rounded-lg border border-stone-300 px-2 py-1.5" />
                      <span>–</span>
                      <input type="time" name={`close_${day}`} value={row?.closeTime ?? '17:00'} class="rounded-lg border border-stone-300 px-2 py-1.5" />
                    </div>
                  </div>
                );
              })}
            </div>
            <button class="mt-5 rounded-xl bg-brand-600 px-6 py-2.5 font-bold text-white shadow-sm shadow-brand-600/20 transition hover:bg-brand-700 active:scale-[.98]">Save hours</button>
          </form>
        </>
      )}

      <!-- ============ BLOCKOUTS ============ -->
      {tab === 'blockouts' && (
        <>
          <h1 class="text-3xl font-black tracking-tight">Days off &amp; time blocks</h1>
          <p class="mt-1 text-sm text-stone-500">Block a day or a time range so no bookings can be made.</p>
          <form method="POST" action="/api/admin/blockouts" class="mt-6 rounded-2xl border border-stone-200/80 bg-white p-6 shadow-sm">
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class="text-sm font-bold text-stone-700" for="date">Date</label>
                <input type="date" id="date" name="date" required class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2" />
              </div>
              <div class="flex items-end gap-3">
                <label class="flex items-center gap-2 pb-2 text-sm font-semibold text-stone-600">
                  <input type="checkbox" name="all_day" value="on" checked class="accent-brand-600" /> All day
                </label>
              </div>
              <div>
                <label class="text-sm font-bold text-stone-700" for="start_time">From</label>
                <input type="time" id="start_time" name="start_time" value="09:00" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2" />
              </div>
              <div>
                <label class="text-sm font-bold text-stone-700" for="end_time">To</label>
                <input type="time" id="end_time" name="end_time" value="17:00" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2" />
              </div>
              <div class="sm:col-span-2">
                <label class="text-sm font-bold text-stone-700" for="note">Note (optional)</label>
                <input id="note" name="note" placeholder="e.g. Public holiday, away" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2" />
              </div>
            </div>
            <button class="mt-5 rounded-xl bg-brand-600 px-6 py-2.5 font-bold text-white shadow-sm shadow-brand-600/20 transition hover:bg-brand-700 active:scale-[.98]">Add block</button>
          </form>

          <div class="mt-6 space-y-2">
            {blockRows.length === 0 && <p class="text-sm text-stone-500">No blocks yet.</p>}
            {blockRows.map((bl) => (
              <div class="flex items-center justify-between rounded-lg bg-white px-4 py-3 shadow-sm">
                <div>
                  <p class="font-semibold">{dayLabel(bl.startAt)}{timeOfDay(bl.startAt) !== '00:00' ? ` · ${timeOfDay(bl.startAt)}–${timeOfDay(bl.endAt)}` : ' · All day'}</p>
                  {bl.note && <p class="text-sm text-stone-500">{bl.note}</p>}
                </div>
                <form method="POST" action="/api/admin/blockouts">
                  <input type="hidden" name="action" value="delete" />
                  <input type="hidden" name="id" value={bl.id} />
                  <button class="text-sm font-bold text-red-500 hover:text-red-700">Remove</button>
                </form>
              </div>
            ))}
          </div>
        </>
      )}

      <!-- ============ INVOICES ============ -->
      {tab === 'invoices' && (
        <>
          <h1 class="text-3xl font-black tracking-tight">Invoices</h1>
          <p class="mt-1 text-sm text-stone-500">Drafts are auto-generated from each booking. Edit and send them when ready.</p>
          <div class="mt-6 space-y-2">
            {invRows.length === 0 && <p class="text-sm text-stone-500">No invoices yet.</p>}
            {invRows.map((inv) => {
              const b = enriched.find((x) => x.id === inv.bookingId);
              return (
                <div class="flex items-center justify-between gap-3 rounded-lg bg-white px-4 py-3 shadow-sm">
                  <div class="min-w-0">
                    <p class="font-bold">{inv.number} <span class={`ml-2 rounded-full px-2 py-0.5 text-xs font-bold ${statusBadge[inv.status] ?? 'bg-stone-100 text-stone-500'}`}>{inv.status}</span></p>
                    <p class="truncate text-sm text-stone-500">
                      {b ? `${b.dogName} · ${b.service?.name} · ${dayLabel(b.slotStart)}` : `Booking #${inv.bookingId}`}
                    </p>
                  </div>
                  <div class="flex shrink-0 items-center gap-3">
                    <span class="font-extrabold">{money(inv.totalCents)}</span>
                    <a href={`/admin/invoices/${inv.id}`} class="rounded-xl bg-brand-600 px-4 py-1.5 text-sm font-bold text-white shadow-sm shadow-brand-600/20 transition hover:bg-brand-700 active:scale-[.98]">Edit / Send</a>
                  </div>
                </div>
              );
            })}
          </div>
        </>
      )}

      <!-- ============ SETTINGS ============ -->
      {tab === 'settings' && (
        <>
          <h1 class="text-3xl font-black tracking-tight">Settings</h1>
          <form method="POST" action="/api/admin/settings" class="mt-6 max-w-xl rounded-2xl border border-stone-200/80 bg-white p-6 shadow-sm">
            <div class="space-y-4">
              <div>
                <label class="text-sm font-bold text-stone-700" for="business_name">Business name</label>
                <input id="business_name" name="business_name" value={settings.business_name ?? ''} class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2" />
              </div>
              <div>
                <label class="text-sm font-bold text-stone-700" for="abn">ABN</label>
                <input id="abn" name="abn" value={settings.abn ?? ''} class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2" />
              </div>
              <div>
                <label class="text-sm font-bold text-stone-700" for="invoice_prefix">Invoice prefix</label>
                <input id="invoice_prefix" name="invoice_prefix" value={settings.invoice_prefix ?? 'INV'} class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2" />
              </div>
              <div>
                <label class="text-sm font-bold text-stone-700" for="bank_details">Bank details (shown on invoices)</label>
                <textarea id="bank_details" name="bank_details" rows="3" placeholder="Account name&#10;BSB&#10;Account number" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2">{settings.bank_details ?? ''}</textarea>
              </div>
            </div>
            <button class="mt-5 rounded-xl bg-brand-600 px-6 py-2.5 font-bold text-white shadow-sm shadow-brand-600/20 transition hover:bg-brand-700 active:scale-[.98]">Save settings</button>
          </form>
        </>
      )}
    </main>
  </body>
</html>
