---
import { loadInvoiceByToken } from '../../lib/invoice';
import { money } from '../../lib/money';
import { dayLabel, fullDateLabel, slotLabel } from '../../lib/tz';
import { formatDuration } from '../../lib/duration';
import { getSettings } from '../../lib/settings';
import type { InvoiceItem } from '../../../db/schema';
import '../../styles/global.css';

const token = Astro.params.token ?? '';
const data = token ? await loadInvoiceByToken(token) : null;

const businessName = 'Winnie & Co Dog Grooming';
const settings = data ? await getSettings(['abn', 'business_name']) : null;
const paid = data?.invoice.status === 'paid';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <title>{data ? `Receipt ${data.invoice.number} · ${businessName}` : 'Receipt not found'}</title>
    <style>
      body { font-family: "Nunito", ui-sans-serif, system-ui, sans-serif; }
    </style>
  </head>
  <body class="bg-stone-100 text-stone-800">
    {data && settings && paid ? (() => {
      const { invoice: inv, booking: b, service, items } = data;
      return (
        <div class="mx-auto max-w-3xl px-4 py-8 sm:py-12">
          <div class="no-print mb-6 flex items-center justify-between">
            <a href="/" class="text-sm font-semibold text-brand-600 hover:text-brand-800">&larr; Back</a>
            <button onclick="window.print()" class="rounded-full bg-brand-600 px-5 py-2 text-sm font-bold text-white hover:bg-brand-700">Print / Save PDF</button>
          </div>

          <div class="rounded-2xl bg-white p-8 shadow-sm sm:p-10">
            <div class="flex flex-wrap items-start justify-between gap-4 border-b border-stone-200 pb-6">
              <div>
                <p class="text-2xl font-black text-brand-800">🐾 Winnie &amp; Co Dog Grooming</p>
                <p class="mt-1 text-sm text-stone-500">Mobile grooming · Berwick &amp; surrounding suburbs<br />0408 700 265 · alisha@winnieandcodoggrooming.com.au</p>
                {settings.abn && <p class="mt-1 text-sm text-stone-500">ABN {settings.abn}</p>}
              </div>
              <div class="text-right">
                <p class="text-xl font-extrabold">RECEIPT</p>
                <p class="text-sm text-stone-500">For invoice {inv.number}</p>
                <span class="mt-2 inline-block rounded-full bg-green-100 px-3 py-1 text-xs font-bold uppercase text-green-700">Paid</span>
              </div>
            </div>

            <div class="mt-6 grid gap-6 sm:grid-cols-2">
              <div class="text-sm">
                <p class="font-bold text-stone-500">BILLED TO</p>
                <p class="mt-1 font-extrabold">{b.customerName}</p>
                <p>{b.address}{b.suburb ? `, ${b.suburb}` : ''}</p>
                <p>{b.customerEmail}</p>
                <p>{b.customerPhone}</p>
              </div>
              <div class="text-sm sm:text-right">
                <p class="font-bold text-stone-500">APPOINTMENT</p>
                <p class="mt-1 font-extrabold">{service?.name}{b.size ? ` · ${b.size}` : ''} · {formatDuration(Math.round((b.slotEnd.getTime() - b.slotStart.getTime()) / 60000))}</p>
                <p>{dayLabel(b.slotStart)} at {slotLabel(b.slotStart).split(',').pop()}</p>
                <p>{b.dogName}{b.dogBreed ? ` (${b.dogBreed})` : ''}</p>
                <p>{inv.paidAt ? `Paid ${fullDateLabel(inv.paidAt)}` : 'Paid'}</p>
              </div>
            </div>

            <table class="mt-8 w-full text-sm">
              <thead>
                <tr class="border-b-2 border-stone-200 text-left text-stone-500">
                  <th class="py-2">Description</th>
                  <th class="py-2 text-right">Qty</th>
                  <th class="py-2 text-right">Amount</th>
                </tr>
              </thead>
              <tbody>
                {items.map((i: InvoiceItem) => (
                  <tr class="border-b border-stone-100">
                    <td class="py-2.5">{i.description}</td>
                    <td class="py-2.5 text-right">{i.quantity}</td>
                    <td class="py-2.5 text-right font-semibold">{money(i.unitPriceCents * i.quantity)}</td>
                  </tr>
                ))}
              </tbody>
            </table>

            <div class="mt-6 flex justify-end">
              <div class="w-56">
                <div class="flex justify-between py-1 text-sm"><span class="text-stone-500">Subtotal</span><span>{money(inv.subtotalCents)}</span></div>
                <div class="flex justify-between border-t-2 border-stone-800 py-2 text-lg font-extrabold"><span>Amount paid</span><span>{money(inv.totalCents)}</span></div>
              </div>
            </div>

            <div class="mt-6 rounded-xl bg-green-50 p-4 text-sm text-green-800">
              <p class="font-bold">PAYMENT RECEIVED</p>
              <p class="mt-1">Thank you — invoice {inv.number} has been paid in full.</p>
            </div>

            {inv.notes && (
              <div class="mt-6 rounded-xl bg-stone-50 p-4 text-sm text-stone-600">
                <p class="font-bold text-stone-500">NOTES</p>
                <p class="mt-1 whitespace-pre-line">{inv.notes}</p>
              </div>
            )}

            <p class="mt-8 text-center text-xs text-stone-400">Thank you for supporting a small, local business! 🐾</p>
          </div>
        </div>
      );
    })() : (
      <div class="mx-auto max-w-md px-4 py-32 text-center">
        <p class="text-4xl">🐶</p>
        <h1 class="mt-4 text-xl font-extrabold text-stone-800">Receipt not available</h1>
        <p class="mt-2 text-sm text-stone-500">
          {data ? 'This invoice has not been marked paid yet, so there is no receipt to show.' : 'This link may be incorrect or the invoice has been removed.'}
        </p>
        <a href="/" class="mt-6 inline-block rounded-full bg-brand-600 px-5 py-2 text-sm font-bold text-white">Back to Winnie &amp; Co</a>
      </div>
    )}
  </body>
</html>
