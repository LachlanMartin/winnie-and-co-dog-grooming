---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Winnie & Co Dog Grooming', description } = Astro.props;
const meta = description ?? 'Mobile dog grooming in Berwick and surrounding suburbs. Gentle, patient, at-home grooming for dogs of all shapes, sizes and temperaments.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={meta} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/images/logo.png" />
  </head>
  <body class="bg-white text-stone-800 antialiased">
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
