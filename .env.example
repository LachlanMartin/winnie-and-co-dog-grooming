# Database (local Docker, or your Neon pooled URL on Vercel)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/winnie

# Admin login
ADMIN_PASSWORD=change-me
ADMIN_SECRET=change-me-too

# Email (Resend). Email sending is skipped when RESEND_API_KEY is unset.
RESEND_API_KEY=
EMAIL_FROM=Winnie & Co <onboarding@resend.dev>
OWNER_EMAIL=alisha@winnieandcodoggrooming.com.au

# Site URL (used in emails). Defaults to http://localhost:4321 in dev.
PUBLIC_SITE_URL=http://localhost:4321
